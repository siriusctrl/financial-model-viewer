{
  "name": "ledgerglass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "schema:generate": "tsx scripts/generate-schema.ts",
    "schema:check": "tsx scripts/generate-schema.ts --check",
    "sample:generate": "tsx scripts/generate-sample.ts",
    "sample:check": "tsx scripts/generate-sample.ts --check",
    "validate": "tsx scripts/validate-model.ts",
    "extraction:check": "node skills/extract-financial-model/scripts/check-extraction.mjs",
    "extraction:preview": "node skills/extract-financial-model/scripts/build-preview.mjs",
    "extraction:serve": "node skills/extract-financial-model/scripts/serve-preview.mjs",
    "workbook:inventory": "python3 skills/extract-financial-model/scripts/inventory-workbook.py",
    "workbook:extract": "python3 skills/extract-financial-model/scripts/extract-mapped-workbook.py",
    "verify:workbook-tools": "python3 skills/extract-financial-model/scripts/test_workbook_tools.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run schema:check && npm run sample:check && npm run verify:workbook-tools && npm run test && npm run build",
    "verify:ui": "playwright test",
    "verify:proof": "node scripts/record-proof.mjs",
    "verify:extraction-preview": "node skills/extract-financial-model/scripts/build-preview.mjs examples/sample-model-db.json --report examples/extraction-report.md --out artifacts/extraction-preview",
    "setup:browsers": "playwright install chromium webkit"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "jsep": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
